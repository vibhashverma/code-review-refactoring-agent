{
  "openapi": "3.1.0",
  "info": {
    "title": "Autonomous Code Review & Refactoring Agent",
    "description": "LangGraph agent that lints and refactors Python code in GitHub pull requests, pausing for human approval before committing.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/webhooks/github": {
      "post": {
        "tags": [
          "webhooks"
        ],
        "summary": "Receive GitHub pull_request webhook events",
        "description": "Start a review for opened/updated pull requests; ignore other events.",
        "operationId": "github_webhook_api_webhooks_github_post",
        "parameters": [
          {
            "name": "x-github-event",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "pull_request",
              "title": "X-Github-Event"
            }
          },
          {
            "name": "x-hub-signature-256",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Hub-Signature-256"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PullRequestEvent"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid signature",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/reviews/{thread_id}": {
      "get": {
        "tags": [
          "reviews"
        ],
        "summary": "Get review status and proposed changes",
        "description": "Return the current state of a review thread.",
        "operationId": "get_review_api_reviews__thread_id__get",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Thread Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewStatus"
                }
              }
            }
          },
          "404": {
            "description": "Unknown thread_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reviews/{thread_id}/approve": {
      "post": {
        "tags": [
          "reviews"
        ],
        "summary": "Approve or reject the proposed refactoring",
        "description": "Approve (commit to GitHub) or reject (regenerate using feedback).",
        "operationId": "decide_api_reviews__thread_id__approve_post",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Thread Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewStatus"
                }
              }
            }
          },
          "404": {
            "description": "Unknown thread_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Review not awaiting approval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "GitHub commit failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprovalRequest": {
        "properties": {
          "approved": {
            "type": "boolean",
            "title": "Approved"
          },
          "feedback": {
            "type": "string",
            "maxLength": 4000,
            "title": "Feedback",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "approved"
        ],
        "title": "ApprovalRequest",
        "description": "Human decision on a proposed refactoring."
      },
      "BranchRef": {
        "properties": {
          "ref": {
            "type": "string",
            "title": "Ref"
          },
          "repo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BranchRepo"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "ref"
        ],
        "title": "BranchRef"
      },
      "BranchRepo": {
        "properties": {
          "full_name": {
            "type": "string",
            "title": "Full Name"
          }
        },
        "type": "object",
        "required": [
          "full_name"
        ],
        "title": "BranchRepo"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "description": "Standard error body."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Owner": {
        "properties": {
          "login": {
            "type": "string",
            "title": "Login"
          }
        },
        "type": "object",
        "required": [
          "login"
        ],
        "title": "Owner"
      },
      "PullRequestEvent": {
        "properties": {
          "action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          },
          "number": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Number"
          },
          "pull_request": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PullRequestInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "repository": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RepositoryInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "zen": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Zen"
          }
        },
        "type": "object",
        "title": "PullRequestEvent",
        "description": "Subset of the GitHub ``pull_request`` webhook payload we rely on.\n\nFields are optional so that ``ping`` events validate; the endpoint enforces\npresence for ``pull_request`` events."
      },
      "PullRequestInfo": {
        "properties": {
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "html_url": {
            "type": "string",
            "title": "Html Url"
          },
          "head": {
            "$ref": "#/components/schemas/BranchRef"
          }
        },
        "type": "object",
        "required": [
          "number",
          "html_url",
          "head"
        ],
        "title": "PullRequestInfo"
      },
      "RepositoryInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name"
          },
          "html_url": {
            "type": "string",
            "title": "Html Url"
          },
          "owner": {
            "$ref": "#/components/schemas/Owner"
          }
        },
        "type": "object",
        "required": [
          "name",
          "full_name",
          "html_url",
          "owner"
        ],
        "title": "RepositoryInfo"
      },
      "ReviewStatus": {
        "properties": {
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "processing | awaiting_approval | completed | skipped | error"
          },
          "pr_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pr Url"
          },
          "branch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Branch"
          },
          "revision_count": {
            "type": "integer",
            "title": "Revision Count",
            "default": 0
          },
          "files": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Files",
            "default": []
          },
          "lint_errors": {
            "additionalProperties": true,
            "type": "object",
            "title": "Lint Errors",
            "default": {}
          },
          "refactored_code": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Refactored Code",
            "default": {}
          },
          "refactored_lint": {
            "additionalProperties": true,
            "type": "object",
            "title": "Refactored Lint",
            "default": {}
          },
          "reviewer_feedback": {
            "type": "string",
            "title": "Reviewer Feedback",
            "default": ""
          },
          "is_approved": {
            "type": "boolean",
            "title": "Is Approved",
            "default": false
          },
          "commits": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array",
            "title": "Commits",
            "default": []
          },
          "error_message": {
            "type": "string",
            "title": "Error Message",
            "default": ""
          },
          "history": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "History",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "thread_id",
          "status"
        ],
        "title": "ReviewStatus",
        "description": "Full review state returned by the status and approval endpoints."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WebhookResponse": {
        "properties": {
          "thread_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thread Id",
            "description": "Review session identifier"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "examples": [
              "processing"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "WebhookResponse",
        "description": "Result of receiving a webhook."
      }
    }
  }
}
